{
  "name": "smart-grievance-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Grievance Redressal & Tracking System for Villages",
  "workspaces": [
    "backend",
    "apps/admin_web",
    "apps/panchayat_web"
  ],
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:admin": "npm run dev --prefix apps/admin_web",
    "dev:panchayat": "npm run dev --prefix apps/panchayat_web",
    "build:backend": "npm run build --prefix backend",
    "build:admin": "npm run build --prefix apps/admin_web",
    "build:panchayat": "npm run build --prefix apps/panchayat_web",
    "build": "npm run build:backend && npm run build:admin && npm run build:panchayat",
    "seed": "npm run seed --prefix backend",
    "test:backend": "npm run test --prefix backend",
    "test": "npm run test:backend"
  }
}
